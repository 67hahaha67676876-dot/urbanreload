    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel  = 0
    corner(knob, 6)

    local state = default or false

    local function setToggle(val)
        state = val
        tw(track, 0.15, {BackgroundColor3 = state and Theme.Accent or Theme.Inactive})
        tw(knob,  0.15, {Position = state and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)})
        lbl.TextColor3 = state and Theme.Text or Theme.SubText
        if onChange then onChange(state) end
    end

    track.MouseButton1Click:Connect(function() setToggle(not state) end)

    if kbBtn then
        -- store in registry table, not as instance attribute
        kbBtnRegistry[kbBtn] = {toggle = function() setToggle(not state) end, name = label}

        kbBtn.MouseButton1Click:Connect(function()
            if pendingKbBtn == kbBtn then
                pendingKbBtn         = nil
                kbBtn.Text           = "[none]"
                kbBtn.TextColor3     = Theme.SubText
            else
                if pendingKbBtn then
                    pendingKbBtn.Text      = "[none]"
                    pendingKbBtn.TextColor3 = Theme.SubText
                end
                pendingKbBtn         = kbBtn
                kbBtn.Text           = "..."
                kbBtn.TextColor3     = Color3.fromRGB(230, 180, 60)
            end
        end)
    end

    return function() return state end, setToggle
end

-- slider
local function makeSlider(parent, label, min, max, default, suffix, onChange, order)
    local container = Instance.new("Frame", parent)
    container.Name             = label or "Slider"
    container.Size             = UDim2.new(1, 0, 0, 38)
    container.BackgroundTransparency = 1
    container.LayoutOrder      = order or 0

    local lbl = newLabel(container, label or "", 11, Theme.SubText)
    lbl.Size     = UDim2.new(0.6, 0, 0, 16)
    lbl.Position = UDim2.new(0, 0, 0, 0)

    local valLbl = newLabel(container, tostring(default) .. (suffix or ""), 11, Theme.Text, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
    valLbl.Size     = UDim2.new(0.4, 0, 0, 16)
    valLbl.Position = UDim2.new(0.6, 0, 0, 0)

    local track = Instance.new("TextButton", container)
    track.Size               = UDim2.new(1, 0, 0, 4)
    track.Position           = UDim2.new(0, 0, 0, 22)
    track.BackgroundColor3   = Theme.Button
    track.BorderSizePixel    = 0
    track.Text               = ""
    track.AutoButtonColor    = false
    corner(track, 2)

    local fill = Instance.new("Frame", track)
    fill.Size             = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Theme.Accent
    fill.BorderSizePixel  = 0
    corner(fill, 2)

    local knob = Instance.new("Frame", track)
    knob.Size             = UDim2.new(0, 10, 0, 10)
    knob.AnchorPoint      = Vector2.new(0.5, 0.5)
    knob.Position         = UDim2.new((default - min) / (max - min), 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel  = 0
    corner(knob, 5)

    local value   = default
    local sliding = false

    local function update(px)
        local ax, as = track.AbsolutePosition.X, track.AbsoluteSize.X
        if as == 0 then return end
        local p = math.clamp((px - ax) / as, 0, 1)
        value = math.floor(min + (max - min) * p * 100 + 0.5) / 100
        if max - min >= 10 then value = math.round(value) end
        tw(fill,  0.05, {Size = UDim2.new(p, 0, 1, 0)})
        tw(knob,  0.05, {Position = UDim2.new(p, 0, 0.5, 0)})
        valLbl.Text = tostring(value) .. (suffix or "")
        if onChange then onChange(value) end
    end

    track.MouseButton1Down:Connect(function(x) sliding = true; update(x) end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
    end)

    return function() return value end
end

-- dropdown / cycle
local function makeDropdown(parent, label, options, default, onChange, order)
    local idx = 1
    for i, v in ipairs(options) do if v == default then idx = i; break end end

    local container = Instance.new("Frame", parent)
    container.Name             = label or "Dropdown"
    container.Size             = UDim2.new(1, 0, 0, 28)
    container.BackgroundTransparency = 1
    container.LayoutOrder      = order or 0

    if label and label ~= "" then
        local lbl = newLabel(container, label, 11, Theme.SubText)
        lbl.Size     = UDim2.new(1, 0, 0, 14)
        lbl.Position = UDim2.new(0, 0, 0, 0)
    end

    local btn = Instance.new("TextButton", container)
    btn.Size               = UDim2.new(1, 0, 0, (label and label ~= "") and 20 or 28)
    btn.Position           = UDim2.new(0, 0, 0, (label and label ~= "") and 14 or 0)
    btn.BackgroundColor3   = Theme.Button
    btn.BackgroundTransparency = 0.2
    btn.BorderSizePixel    = 0
    btn.Text               = ""
    btn.AutoButtonColor    = false
    corner(btn, 4)
    stroke(btn, Theme.Outline, 1, 0.5)

    local valLbl = newLabel(btn, options[idx], 10, Theme.Text)
    valLbl.Size     = UDim2.new(1, -20, 1, 0)
    valLbl.Position = UDim2.new(0, 8, 0, 0)

    local arrow = newLabel(btn, "▾", 10, Theme.SubText, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
    arrow.Size     = UDim2.new(0, 18, 1, 0)
    arrow.Position = UDim2.new(1, -18, 0, 0)

    btn.MouseButton1Click:Connect(function()
        idx = idx % #options + 1
        valLbl.Text = options[idx]
        if onChange then onChange(options[idx]) end
    end)

    return function() return options[idx] end
end

-- color swatch (click cycles preset colors)
local PRESET_COLORS = {
    Color3.fromRGB(59, 130, 246),
    Color3.fromRGB(200, 30, 30),
    Color3.fromRGB(80, 200, 130),
    Color3.fromRGB(230, 180, 60),
    Color3.fromRGB(180, 80, 220),
    Color3.fromRGB(255, 255, 255),
}
local function makeColorSwatch(parent, default, onChange)
    local cidx = 1
    for i, c in ipairs(PRESET_COLORS) do if c == default then cidx = i; break end end

    local swatch = Instance.new("TextButton", parent)
    swatch.Size               = UDim2.new(0, 18, 0, 18)
    swatch.BackgroundColor3   = PRESET_COLORS[cidx]
    swatch.BorderSizePixel    = 0
    swatch.Text               = ""
    swatch.AutoButtonColor    = false
    corner(swatch, 3)
    stroke(swatch, Theme.Outline, 1, 0.3)

    swatch.MouseButton1Click:Connect(function()
        cidx = cidx % #PRESET_COLORS + 1
        swatch.BackgroundColor3 = PRESET_COLORS[cidx]
        if onChange then onChange(PRESET_COLORS[cidx]) end
    end)

    return function() return PRESET_COLORS[cidx] end

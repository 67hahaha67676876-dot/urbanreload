local function makeDropdown(parent, label, options, default, onChange, order)
    local idx = 1
    for i, v in ipairs(options) do if v == default then idx = i; break end end
    local container = Instance.new("Frame", parent)
    container.Name = label or "Dropdown"; container.Size = UDim2.new(1, 0, 0, 28)
    container.BackgroundTransparency = 1; container.LayoutOrder = order or 0
    if label and label ~= "" then
        local lbl = newLabel(container, label, 11, Theme.SubText)
        lbl.Size = UDim2.new(1, 0, 0, 14); lbl.Position = UDim2.new(0, 0, 0, 0)
    end
    local btn = Instance.new("TextButton", container)
    btn.Size = UDim2.new(1, 0, 0, (label and label ~= "") and 20 or 28)
    btn.Position = UDim2.new(0, 0, 0, (label and label ~= "") and 14 or 0)
    btn.BackgroundColor3 = Theme.Button; btn.BackgroundTransparency = 0.2
    btn.BorderSizePixel = 0; btn.Text = ""; btn.AutoButtonColor = false
    corner(btn, 4); stroke(btn, Theme.Outline, 1, 0.5)
    local valLbl = newLabel(btn, options[idx], 10, Theme.Text)
    valLbl.Size = UDim2.new(1, -20, 1, 0); valLbl.Position = UDim2.new(0, 8, 0, 0)
    local arrow = newLabel(btn, "v", 10, Theme.SubText, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
    arrow.Size = UDim2.new(0, 18, 1, 0); arrow.Position = UDim2.new(1, -18, 0, 0)
    btn.MouseButton1Click:Connect(function()
        idx = idx % #options + 1; valLbl.Text = options[idx]
        if onChange then onChange(options[idx]) end
    end)
    return function() return options[idx] end
end


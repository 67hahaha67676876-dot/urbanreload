local function makeNavBtn(cfg, i)
    local btn = Instance.new("TextButton", NavScroll)
    btn.Name                   = "Nav_" .. cfg.id
    btn.Size                   = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3       = Theme.Section
    btn.BackgroundTransparency = (i == 1) and 0.3 or 1
    btn.BorderSizePixel        = 0
    btn.Text                   = ""
    btn.AutoButtonColor        = false
    btn.LayoutOrder            = i
    corner(btn, 6)

    local indicator = Instance.new("Frame", btn)
    indicator.Size             = (i == 1) and UDim2.new(0, 3, 0, 18) or UDim2.new(0, 3, 0, 0)
    indicator.Position         = UDim2.new(0, 0, 0.5, 0)
    indicator.AnchorPoint      = Vector2.new(0, 0.5)
    indicator.BackgroundColor3 = Theme.Accent
    indicator.BorderSizePixel  = 0
    indicator.Visible          = (i == 1)
    corner(indicator, 2)

    local iconLbl = newLabel(btn, cfg.icon, 13, (i == 1) and Theme.Accent or Theme.SubText, Enum.Font.GothamBold)
    iconLbl.Size     = UDim2.new(0, 24, 1, 0)
    iconLbl.Position = UDim2.new(0, 10, 0, 0)
    iconLbl.TextXAlignment = Enum.TextXAlignment.Center

    local nameLbl = newLabel(btn, cfg.label, 11, (i == 1) and Theme.Text or Theme.SubText, Enum.Font.GothamMedium)
    nameLbl.Size     = UDim2.new(1, -40, 1, 0)
    nameLbl.Position = UDim2.new(0, 36, 0, 0)

    btn.MouseEnter:Connect(function()
        if activeNav ~= cfg.id then
            tw(btn,     0.12, {BackgroundTransparency = 0.6, BackgroundColor3 = Theme.Section})
            tw(nameLbl, 0.12, {TextColor3 = Theme.Text})
        end
    end)
    btn.MouseLeave:Connect(function()
        if activeNav ~= cfg.id then
            tw(btn,     0.12, {BackgroundTransparency = 1})
            tw(nameLbl, 0.12, {TextColor3 = Theme.SubText})
        end
    end)

    btn.MouseButton1Click:Connect(function()
        if activeNav == cfg.id then return end
        tabPages[activeNav].Visible = false
        activeNav = cfg.id
        tabPages[cfg.id].Visible = true

        for _, c in ipairs(navConfig) do
            local b   = navButtons[c.id]
            local ind = b:FindFirstChildOfClass("Frame")
            local nl  = b:FindFirstChildOfClass("TextLabel")
            local il  = b:FindFirstChild("TextLabel")
            local active = (c.id == cfg.id)
            if ind then
                ind.Visible = active
                tw(ind, 0.18, {Size = active and UDim2.new(0,3,0,18) or UDim2.new(0,3,0,0)})
            end
            -- find labels by name position
            for _, child in ipairs(b:GetChildren()) do
                if child:IsA("TextLabel") then
                    if child.Position.X.Offset == 36 then
                        tw(child, 0.12, {TextColor3 = active and Theme.Text or Theme.SubText})
                    elseif child.Position.X.Offset == 10 then
                        tw(child, 0.12, {TextColor3 = active and Theme.Accent or Theme.SubText})
                    end
                end
            end
            tw(b, 0.18, {BackgroundTransparency = active and 0.3 or 1, BackgroundColor3 = Theme.Section})
        end
    end)

    navButtons[cfg.id] = btn
    return btn
end

for i, cfg in ipairs(navConfig) do makeNavBtn(cfg, i) end


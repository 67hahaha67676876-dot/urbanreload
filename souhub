        pcall(function() pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
        wmFrame.Visible = S.Watermark
        if S.Watermark then wmText.Text = "Sou Hub  |  " .. fps .. " FPS  |  " .. pingVal .. " MS" end
        fpsCount = 0; fpsLast = tick()
    end

    -- FLY (BodyVelocity based)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if S.Fly and root then
        if not flyBV or flyBV.Parent ~= root then
            cleanFly()
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = true end
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            flyBV.Velocity = Vector3.new(0, 0, 0)
            flyBV.Parent = root
            flyBG = Instance.new("BodyGyro")
            flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            flyBG.D = 200; flyBG.P = 9000
            flyBG.Parent = root
        end
        local dir = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W)     then dir = dir + Camera.CFrame.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.S)     then dir = dir - Camera.CFrame.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.A)     then dir = dir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D)     then dir = dir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0)        end
        if dir.Magnitude > 0 then dir = dir.Unit end
        flyBV.Velocity = dir * S.FlySpeed
        flyBG.CFrame = Camera.CFrame
    else
        if flyBV then cleanFly() end
    end

    -- AIMBOT (Auto camlock - en yakin kisiyi her frame takip eder)
    if not S.Aimbot then locked = false; S.CurrentTarget = nil
    else
        S.CurrentTarget = getClosest()
        locked = S.CurrentTarget ~= nil
        if locked and S.CurrentTarget and S.CurrentTarget.Character then
            local tChar = S.CurrentTarget.Character
            local part = tChar:FindFirstChild(S.AimbotPart) or tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Head")
            -- Arabadaki oyuncu icin SeatPart fallback
            if not part then
                pcall(function()
                    local hum = tChar:FindFirstChildOfClass("Humanoid")
                    if hum and hum.SeatPart then part = hum.SeatPart end
                end)
            end
            if part then
                local h = tChar:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    local vel = Vector3.new()
                    pcall(function() vel = part.AssemblyLinearVelocity end)
                    local predicted = part.Position + vel * 0.05
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, predicted), S.AimbotSmoothing)
                end
            end
        end
    end

    -- TRIGGER
    if S.TriggerBot and S.CurrentTarget and S.CurrentTarget.Character then
        local part = S.CurrentTarget.Character:FindFirstChild(S.TriggerPart)
        if part then
            local sp2, on2 = Camera:WorldToViewportPoint(part.Position)
            if on2 then
                local cx2 = Camera.ViewportSize.X/2; local cy2 = Camera.ViewportSize.Y/2
                if math.sqrt((sp2.X-cx2)^2+(sp2.Y-cy2)^2) < 20 then
                    local c = char and char:FindFirstChildOfClass("Tool")
                    if c then task.delay(S.TriggerReaction, function() pcall(function() c:Activate() end) end) end
                end
            end
        end
    end

    -- ESP en sona (kamera aimbot tarafindan hareket ettirildikten SONRA guncellenir)
    -- Boylece box her zaman dogru ekran konumunda gozukur
    pcall(updateESP)
end)


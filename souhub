    local barLayout = Instance.new("UIListLayout", bar)
    barLayout.FillDirection = Enum.FillDirection.Horizontal
    barLayout.SortOrder     = Enum.SortOrder.LayoutOrder
    barLayout.Padding       = UDim.new(0, 2)
    local barPad = Instance.new("UIPadding", bar)
    barPad.PaddingLeft   = UDim.new(0, 4)
    barPad.PaddingRight  = UDim.new(0, 4)
    barPad.PaddingTop    = UDim.new(0, 4)
    barPad.PaddingBottom = UDim.new(0, 4)

    local subPages = {}
    local subBtns  = {}
    local activeSub = tabs[1].id

    for i, tab in ipairs(tabs) do
        local sbtn = Instance.new("TextButton", bar)
        sbtn.Name                   = "Sub_" .. tab.id
        sbtn.Size                   = UDim2.new(1/#tabs, -4, 1, 0)
        sbtn.BackgroundColor3       = (i == 1) and Theme.SectionTop or Color3.fromRGB(0,0,0)
        sbtn.BackgroundTransparency = (i == 1) and 0 or 1
        sbtn.BorderSizePixel        = 0
        sbtn.Text                   = tab.label
        sbtn.TextColor3             = (i == 1) and Theme.Text or Theme.SubText
        sbtn.TextSize               = 11
        sbtn.Font                   = Enum.Font.GothamMedium
        sbtn.AutoButtonColor        = false
        corner(sbtn, 4)
        subBtns[tab.id] = sbtn

        local sp = Instance.new("Frame", parentPage)

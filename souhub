    end
    local track = Instance.new("TextButton", row)
    track.Size               = UDim2.new(0, 30, 0, 16)
    track.Position           = UDim2.new(1, -30, 0.5, -8)
    track.BackgroundColor3   = default and Theme.Accent or Theme.Inactive
    track.BorderSizePixel    = 0
    track.Text               = ""
    track.AutoButtonColor    = false
    corner(track, 8)
    local knob = Instance.new("Frame", track)
    knob.Size             = UDim2.new(0, 12, 0, 12)
    knob.Position         = default and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel  = 0
    corner(knob, 6)
    local state = default or false
    local function setToggle(val)
        state = val
        tw(track, 0.15, {BackgroundColor3 = state and Theme.Accent or Theme.Inactive})
        tw(knob,  0.15, {Position = state and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)})
        lbl.TextColor3 = state and Theme.Text or Theme.SubText
        if onChange then onChange(state) end
    end
    track.MouseButton1Click:Connect(function() setToggle(not state) end)
    if kbBtn then
        kbBtnRegistry[kbBtn] = {toggle = function() setToggle(not state) end, name = label}
        kbBtn.MouseButton1Click:Connect(function()
            if pendingKbBtn == kbBtn then
                pendingKbBtn = nil; kbBtn.Text = "[none]"; kbBtn.TextColor3 = Theme.SubText
            else
                if pendingKbBtn then pendingKbBtn.Text = "[none]"; pendingKbBtn.TextColor3 = Theme.SubText end
                pendingKbBtn = kbBtn; kbBtn.Text = "..."; kbBtn.TextColor3 = Color3.fromRGB(230, 180, 60)
            end
        end)
    end
    return function() return state end, setToggle
end

-- slider
local function makeSlider(parent, label, min, max, default, suffix, onChange, order)
    local container = Instance.new("Frame", parent)
    container.Name = label or "Slider"; container.Size = UDim2.new(1, 0, 0, 38)
    container.BackgroundTransparency = 1; container.LayoutOrder = order or 0
    local lbl = newLabel(container, label or "", 11, Theme.SubText)
    lbl.Size = UDim2.new(0.6, 0, 0, 16); lbl.Position = UDim2.new(0, 0, 0, 0)
    local valLbl = newLabel(container, tostring(default) .. (suffix or ""), 11, Theme.Text, Enum.Font.GothamBold, Enum.TextXAlignment.Right)
    valLbl.Size = UDim2.new(0.4, 0, 0, 16); valLbl.Position = UDim2.new(0.6, 0, 0, 0)
    local track = Instance.new("TextButton", container)
    track.Size = UDim2.new(1, 0, 0, 4); track.Position = UDim2.new(0, 0, 0, 22)
    track.BackgroundColor3 = Theme.Button; track.BorderSizePixel = 0; track.Text = ""; track.AutoButtonColor = false
    corner(track, 2)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0); fill.BackgroundColor3 = Theme.Accent; fill.BorderSizePixel = 0
    corner(fill, 2)
    local knob2 = Instance.new("Frame", track)
    knob2.Size = UDim2.new(0, 10, 0, 10); knob2.AnchorPoint = Vector2.new(0.5, 0.5)
    knob2.Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0)
    knob2.BackgroundColor3 = Color3.fromRGB(255, 255, 255); knob2.BorderSizePixel = 0
    corner(knob2, 5)
    local value = default; local sliding = false
    local function update(px)
        local ax, as = track.AbsolutePosition.X, track.AbsoluteSize.X
        if as == 0 then return end
        local p = math.clamp((px - ax) / as, 0, 1)
        value = math.floor(min + (max - min) * p * 100 + 0.5) / 100
        if max - min >= 10 then value = math.round(value) end
        tw(fill, 0.05, {Size = UDim2.new(p, 0, 1, 0)})
        tw(knob2, 0.05, {Position = UDim2.new(p, 0, 0.5, 0)})
        valLbl.Text = tostring(value) .. (suffix or "")
        if onChange then onChange(value) end
    end
    track.MouseButton1Down:Connect(function(x) sliding = true; update(x) end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then update(input.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
    end)
    return function() return value end
end


-- each page has subtabs rendered at the top
local subTabContainers = {}  -- [pageId] = {bar, pages={}}

local function makeSubTabSystem(parentPage, tabs)
    -- tab bar
    local bar = Instance.new("Frame", parentPage)
    bar.Name             = "SubBar"
    bar.Size             = UDim2.new(1, 0, 0, 32)
    bar.BackgroundColor3 = Theme.Panel
    bar.BorderSizePixel  = 0
    bar.LayoutOrder      = 0
    corner(bar, 6)

    local barLayout = Instance.new("UIListLayout", bar)
    barLayout.FillDirection = Enum.FillDirection.Horizontal
    barLayout.SortOrder     = Enum.SortOrder.LayoutOrder
    barLayout.Padding       = UDim.new(0, 2)
    local barPad = Instance.new("UIPadding", bar)
    barPad.PaddingLeft   = UDim.new(0, 4)
    barPad.PaddingRight  = UDim.new(0, 4)
    barPad.PaddingTop    = UDim.new(0, 4)
    barPad.PaddingBottom = UDim.new(0, 4)

    -- content holder — a regular frame with children per sub-tab
    -- each sub-tab gets its own ScrollingFrame inside parentPage
    local subPages = {}
    local subBtns  = {}
    local activeSub = tabs[1].id

    for i, tab in ipairs(tabs) do
        -- subtab button
        local sbtn = Instance.new("TextButton", bar)
        sbtn.Name                   = "Sub_" .. tab.id
        sbtn.Size                   = UDim2.new(1/#tabs, -4, 1, 0)
        sbtn.BackgroundColor3       = (i == 1) and Theme.SectionTop or Color3.fromRGB(0,0,0)
        sbtn.BackgroundTransparency = (i == 1) and 0 or 1
        sbtn.BorderSizePixel        = 0
        sbtn.Text                   = tab.label
        sbtn.TextColor3             = (i == 1) and Theme.Text or Theme.SubText
        sbtn.TextSize               = 11
        sbtn.Font                   = Enum.Font.GothamMedium
        sbtn.AutoButtonColor        = false
        corner(sbtn, 4)
        subBtns[tab.id] = sbtn

        -- sub page (just a frame with UIListLayout, inside parentPage's scroll)
        local sp = Instance.new("Frame", parentPage)
        sp.Name             = "SubPage_" .. tab.id
        sp.Size             = UDim2.new(1, 0, 0, 0)
        sp.BackgroundTransparency = 1
        sp.BorderSizePixel  = 0
        sp.AutomaticSize    = Enum.AutomaticSize.Y
        sp.Visible          = (i == 1)
        sp.LayoutOrder      = i

        local spLayout = Instance.new("UIListLayout", sp)
        spLayout.SortOrder = Enum.SortOrder.LayoutOrder
        spLayout.Padding   = UDim.new(0, 6)

        subPages[tab.id] = sp

        sbtn.MouseButton1Click:Connect(function()
            if activeSub == tab.id then return end
            subPages[activeSub].Visible = false
            activeSub = tab.id
            subPages[tab.id].Visible = true
            for _, t2 in ipairs(tabs) do
                local b = subBtns[t2.id]
                local active = (t2.id == tab.id)
                tw(b, 0.12, {
                    BackgroundTransparency = active and 0 or 1,
                    BackgroundColor3       = active and Theme.SectionTop or Color3.fromRGB(0,0,0),
                    TextColor3             = active and Theme.Text or Theme.SubText,
                })
            end
        end)
    end

    return subPages
end


-- ─── ESP ─────────────────────────────────────────────────────────────────────
local hasDrawing = false
pcall(function() local t = Drawing.new("Line"); t:Remove(); hasDrawing = true end)

local espObjects = {}

local function removeESP(name)
    local obj = espObjects[name]
    if not obj then return end
    for _, v in pairs(obj) do pcall(function() v:Remove() end) end
    espObjects[name] = nil
end

local function hideESP(name)
    local obj = espObjects[name]
    if not obj then return end
    for _, v in pairs(obj) do pcall(function() v.Visible = false end) end
end

local function createESP(name)
    if not hasDrawing then return end
    local function line()
        local l = Drawing.new("Line")
        l.Thickness = 1; l.Color = Color3.fromRGB(255,255,255); l.Visible = false
        return l
    end
    local function txt(sz)
        local t = Drawing.new("Text")
        t.Size = sz or 12; t.Center = true; t.Outline = true
        t.OutlineColor = Color3.fromRGB(0,0,0); t.Font = 2; t.Visible = false
        return t
    end
    espObjects[name] = {
        boxT = line(), boxB = line(), boxL = line(), boxR = line(),
        hpBg = Drawing.new("Line"),
        hpFg = Drawing.new("Line"),
        name = txt(12), dist = txt(11),
    }
    local hp = espObjects[name]
    hp.hpBg.Thickness = 3; hp.hpBg.Color = Color3.fromRGB(50,50,50); hp.hpBg.Visible = false
    hp.hpFg.Thickness = 3; hp.hpFg.Color = Color3.fromRGB(80,200,80); hp.hpFg.Visible = false
end

local function updateESP()
    if not hasDrawing then return end
    for name in pairs(espObjects) do
        if not Players:FindFirstChild(name) then removeESP(name) end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local show = S.ESPEnabled
        if not show or not plr.Character then hideESP(plr.Name); continue end

        local char = plr.Character
        local hum  = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")

        if not hum or hum.Health <= 0 or not root then hideESP(plr.Name); continue end
        if not espObjects[plr.Name] then createESP(plr.Name) end

        local obj = espObjects[plr.Name]
        local headPos = head and head.Position or (root.Position + Vector3.new(0,2,0))

        local sp, onScreen = Camera:WorldToViewportPoint(headPos)
        local topSP = Camera:WorldToViewportPoint(headPos + Vector3.new(0,1,0))
        local botSP = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))
        local lSP   = Camera:WorldToViewportPoint(root.Position + Vector3.new(-1,1,0))
        local rSP   = Camera:WorldToViewportPoint(root.Position + Vector3.new( 1,1,0))

        local dist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)
        if not onScreen or dist > 600 then hideESP(plr.Name); continue end

        local cx   = (lSP.X + rSP.X) / 2
        local half = math.abs(rSP.X - lSP.X) / 2
        local topY = topSP.Y
        local botY = botSP.Y

        if S.BoundingBox then
            local white = Color3.fromRGB(255,255,255)
            obj.boxT.From = Vector2.new(cx-half, topY); obj.boxT.To = Vector2.new(cx+half, topY); obj.boxT.Color = white; obj.boxT.Visible = true
            obj.boxB.From = Vector2.new(cx-half, botY); obj.boxB.To = Vector2.new(cx+half, botY); obj.boxB.Color = white; obj.boxB.Visible = true
            obj.boxL.From = Vector2.new(cx-half, topY); obj.boxL.To = Vector2.new(cx-half, botY); obj.boxL.Color = white; obj.boxL.Visible = true
            obj.boxR.From = Vector2.new(cx+half, topY); obj.boxR.To = Vector2.new(cx+half, botY); obj.boxR.Color = white; obj.boxR.Visible = true
        else
            obj.boxT.Visible = false; obj.boxB.Visible = false
            obj.boxL.Visible = false; obj.boxR.Visible = false
        end

        local hp  = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        local boxH = botY - topY
        if S.HealthBar and boxH > 4 then
            obj.hpBg.From = Vector2.new(cx-half-5, topY)
            obj.hpBg.To   = Vector2.new(cx-half-5, botY)
            obj.hpBg.Visible = true
            obj.hpFg.From = Vector2.new(cx-half-5, topY + boxH*(1-hp))
            obj.hpFg.To   = Vector2.new(cx-half-5, botY)
            obj.hpFg.Color = Color3.fromRGB(255*( 1-hp), 255*hp, 0)
            obj.hpFg.Visible = true
        else
            obj.hpBg.Visible = false; obj.hpFg.Visible = false
        end

        local yOff = topY - 16
        if S.ESPName then
            obj.name.Text     = plr.DisplayName
            obj.name.Position = Vector2.new(cx, yOff)
            obj.name.Color    = Color3.fromRGB(255,255,255)
            obj.name.Visible  = true
            yOff = yOff - 13
        else obj.name.Visible = false end

        if S.ESPDistance then
            obj.dist.Text     = dist .. "m"
            obj.dist.Position = Vector2.new(cx, yOff)
            obj.dist.Color    = Color3.fromRGB(180,180,180)
            obj.dist.Visible  = true
        else obj.dist.Visible = false end
    end
end

-- ─── AIMBOT UTIL ─────────────────────────────────────────────────────────────
local function isDowned(char)
    if not char then return false end
    local fx = char:FindFirstChild("BodyEffects")
    if fx then local ko = fx:FindFirstChild("K.O"); if ko and ko.Value then return true end end
    return char:FindFirstChild("GRABBING_CONSTRAINT") ~= nil
end

local function wallCheck(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local dir    = part.Position - origin
    local rp     = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    rp.IgnoreWater = true
    local hit = workspace:Raycast(origin, dir, rp)
    if not hit then return true end
    local tc = part:FindFirstAncestorOfClass("Model")
    return tc and hit.Instance:IsDescendantOf(tc)
end

local function getClosest()
    local cx   = Camera.ViewportSize.X / 2
    local cy   = Camera.ViewportSize.Y / 2
    local fov  = S.FOVRadius
    local best, bestD = nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character
        if not char then continue end
        local part = char:FindFirstChild(S.AimbotPart) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        if isDowned(char) then continue end
        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local d = math.sqrt((sp.X-cx)^2 + (sp.Y-cy)^2)
        if (not S.AimbotFOV or d < fov) and d < bestD then
            if not S.AimbotWallCheck or wallCheck(part) then
                bestD = d; best = plr
            end
        end
    end
    return best
end


local hasDrawing = false
pcall(function() local t = Drawing.new("Line"); t:Remove(); hasDrawing = true end)

local espObjects = {}
local function removeESP(name)
    local obj = espObjects[name]; if not obj then return end
    for _, v in pairs(obj) do pcall(function() v:Remove() end) end
    espObjects[name] = nil
end
local function hideESP(name)
    local obj = espObjects[name]; if not obj then return end
    for _, v in pairs(obj) do pcall(function() v.Visible = false end) end
end
local function createESP(name)
    if not hasDrawing then return end
    local function line() local l = Drawing.new("Line"); l.Thickness = 1; l.Color = Color3.fromRGB(255,255,255); l.Visible = false; return l end
    local function txt(sz) local t = Drawing.new("Text"); t.Size = sz or 12; t.Center = true; t.Outline = true; t.OutlineColor = Color3.fromRGB(0,0,0); t.Font = 2; t.Visible = false; return t end
    espObjects[name] = {
        boxT = line(), boxB = line(), boxL = line(), boxR = line(),
        hpBg = Drawing.new("Line"), hpFg = Drawing.new("Line"),
        name = txt(12), dist = txt(11), weapon = txt(10),
    }
    local hp = espObjects[name]
    hp.hpBg.Thickness = 3; hp.hpBg.Color = Color3.fromRGB(50,50,50); hp.hpBg.Visible = false
    hp.hpFg.Thickness = 3; hp.hpFg.Color = Color3.fromRGB(80,200,80); hp.hpFg.Visible = false
end

local function getCharacterBounds(char, root, head)
    -- Karakterin gercek boyutunu hesapla (tum BasePart'larin CFrame'ini kullanarak)
    local minY = root.Position.Y - 3
    local maxY = (head and head.Position.Y or root.Position.Y) + 0.8
    local halfWidth = 2.5 -- karakter genisligi yaklasik 5 stud

    -- Karakter icindeki partlardan gercek boyut hesapla
    pcall(function()
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local pos = part.Position
                local sz = part.Size
                local top = pos.Y + sz.Y / 2
                local bot = pos.Y - sz.Y / 2
                if top > maxY then maxY = top end
                if bot < minY then minY = bot end
            end
        end
    end)

    -- Biraz padding ekle
    maxY = maxY + 0.3
    minY = minY - 0.2

    return minY, maxY, halfWidth
end

local function updateESP()
    if not hasDrawing then return end
    for name in pairs(espObjects) do if not Players:FindFirstChild(name) then removeESP(name) end end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if not S.ESPEnabled or not plr.Character then hideESP(plr.Name); continue end
        local char = plr.Character
        local hum  = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        -- Arabadaki oyuncu icin SeatPart fallback
        if not root and hum then pcall(function() if hum.SeatPart then root = hum.SeatPart end end) end
        if not hum or hum.Health <= 0 or not root then hideESP(plr.Name); continue end
        if not espObjects[plr.Name] then createESP(plr.Name) end
        local obj = espObjects[plr.Name]

        local dist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)
        if dist > 600 then hideESP(plr.Name); continue end

        -- Karakter boyutunu hesapla
        local minY, maxY, halfWidth = getCharacterBounds(char, root, head)

        -- 4 kose noktasini ekrana projekte et
        local topPos = Vector3.new(root.Position.X, maxY, root.Position.Z)
        local botPos = Vector3.new(root.Position.X, minY, root.Position.Z)

        local topSP, onTop = Camera:WorldToViewportPoint(topPos)
        local botSP, onBot = Camera:WorldToViewportPoint(botPos)

        if not onTop and not onBot then hideESP(plr.Name); continue end

        -- Box genisligini mesafeye gore hesapla (perspektif)
        local leftWorld = root.Position + Camera.CFrame.RightVector * (-halfWidth)
        local rightWorld = root.Position + Camera.CFrame.RightVector * halfWidth
        local leftSP = Camera:WorldToViewportPoint(leftWorld)
        local rightSP = Camera:WorldToViewportPoint(rightWorld)

        local screenWidth = math.abs(rightSP.X - leftSP.X)
        local half = math.max(screenWidth / 2, 8) -- minimum 8px genislik

        local cx = (leftSP.X + rightSP.X) / 2
        local topY = topSP.Y
        local botY = botSP.Y
        local boxH = botY - topY

        -- Box cok kucuk veya ters ise gosterme
        if boxH < 4 or boxH > 2000 then hideESP(plr.Name); continue end

        if S.BoundingBox then
            local w = Color3.fromRGB(255,255,255)
            obj.boxT.From = Vector2.new(cx-half, topY); obj.boxT.To = Vector2.new(cx+half, topY); obj.boxT.Color = w; obj.boxT.Visible = true
            obj.boxB.From = Vector2.new(cx-half, botY); obj.boxB.To = Vector2.new(cx+half, botY); obj.boxB.Color = w; obj.boxB.Visible = true
            obj.boxL.From = Vector2.new(cx-half, topY); obj.boxL.To = Vector2.new(cx-half, botY); obj.boxL.Color = w; obj.boxL.Visible = true
            obj.boxR.From = Vector2.new(cx+half, topY); obj.boxR.To = Vector2.new(cx+half, botY); obj.boxR.Color = w; obj.boxR.Visible = true
        else obj.boxT.Visible = false; obj.boxB.Visible = false; obj.boxL.Visible = false; obj.boxR.Visible = false end
        local hpPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        if S.HealthBar and boxH > 4 then
            obj.hpBg.From = Vector2.new(cx-half-5, topY); obj.hpBg.To = Vector2.new(cx-half-5, botY); obj.hpBg.Visible = true
            obj.hpFg.From = Vector2.new(cx-half-5, topY + boxH*(1-hpPct)); obj.hpFg.To = Vector2.new(cx-half-5, botY)
            obj.hpFg.Color = Color3.fromRGB(255*(1-hpPct), 255*hpPct, 0); obj.hpFg.Visible = true
        else obj.hpBg.Visible = false; obj.hpFg.Visible = false end
        local yOff = topY - 16
        if S.ESPName then obj.name.Text = plr.DisplayName; obj.name.Position = Vector2.new(cx, yOff); obj.name.Color = Color3.fromRGB(255,255,255); obj.name.Visible = true; yOff = yOff - 13
        else obj.name.Visible = false end
        if S.ESPDistance then obj.dist.Text = dist .. "m"; obj.dist.Position = Vector2.new(cx, yOff); obj.dist.Color = Color3.fromRGB(180,180,180); obj.dist.Visible = true
        else obj.dist.Visible = false end
        -- Weapon ESP
        local weaponName = ""
        pcall(function()
            local equipped = char:FindFirstChildOfClass("Tool")
            if equipped then weaponName = equipped.Name end
        end)
        if weaponName ~= "" then
            obj.weapon.Text = "[" .. weaponName .. "]"; obj.weapon.Position = Vector2.new(cx, botY + 4); obj.weapon.Color = Color3.fromRGB(255,200,100); obj.weapon.Visible = true
        else
            obj.weapon.Visible = false
        end
    end
end

-- â”€â”€â”€ AIMBOT UTIL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
local LOCK_MAX_DIST = 360 -- stud, maksimum lock mesafesi

local function isDowned(char)
    if not char then return false end
    local fx = char:FindFirstChild("BodyEffects")
    if fx then local ko = fx:FindFirstChild("K.O"); if ko and ko.Value then return true end end
    return char:FindFirstChild("GRABBING_CONSTRAINT") ~= nil
end

local function wallCheck(part)
    if not part then return false end
    local origin = Camera.CFrame.Position; local dir = part.Position - origin
    local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LocalPlayer.Character, Camera}; rp.IgnoreWater = true
    local hit = workspace:Raycast(origin, dir, rp)
    if not hit then return true end
    local tc = part:FindFirstAncestorOfClass("Model")
    return tc and hit.Instance:IsDescendantOf(tc)
end

local function getClosest()
    local cx = Camera.ViewportSize.X / 2; local cy = Camera.ViewportSize.Y / 2
    local fov = S.FOVRadius; local best, bestD = nil, math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        local char = plr.Character; if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        if isDowned(char) then continue end

        -- Hedef part bul (arabada olsa bile HumanoidRootPart veya Head var)
        local part = char:FindFirstChild(S.AimbotPart)
        if not part then part = char:FindFirstChild("HumanoidRootPart") end
        if not part then part = char:FindFirstChild("Head") end
        if not part then
            -- Arabadaki oyuncu: SeatPart uzerinden pozisyon al
            pcall(function()
                if hum.SeatPart then part = hum.SeatPart end
            end)
        end
        if not part then continue end

        -- Mesafe kontrolu (360 stud sinir)
        if myRoot then
            local worldDist = (myRoot.Position - part.Position).Magnitude
            if worldDist > LOCK_MAX_DIST then continue end
        end

        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local d = math.sqrt((sp.X-cx)^2 + (sp.Y-cy)^2)
        if (not S.AimbotFOV or d < fov) and d < bestD then
            if not S.AimbotWallCheck or wallCheck(part) then bestD = d; best = plr end
        end
    end
    return best
end


        local r = S.FOVRadius
        fovFrame.Size     = UDim2.new(0, r*2, 0, r*2)
        fovFrame.Position = UDim2.new(0.5, -r, 0.5, -r)
    end

    -- FPS / watermark
    fpsCount = fpsCount + 1
    if tick() - fpsLast >= 1 then
        local fps = fpsCount
        pcall(function() pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
        wmFrame.Visible = S.Watermark
        if S.Watermark then
            wmText.Text = "Sou Hub  |  " .. fps .. " FPS  |  " .. pingVal .. " MS"
        end
        fpsCount = 0; fpsLast = tick()
    end

    -- fly
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if S.Fly and root then
        if not flyLV or flyLV.Parent ~= root then
            cleanFly()
            flyAtt = Instance.new("Attachment", root)
            flyLV  = Instance.new("LinearVelocity", root)
            flyLV.Attachment0            = flyAtt
            flyLV.MaxForce               = math.huge
            flyLV.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
            flyLV.VectorVelocity         = Vector3.new()
        end
        local dir = Vector3.new()
        local UIS = UserInputService
        if UIS:IsKeyDown(Enum.KeyCode.W)     then dir = dir + Camera.CFrame.LookVector  end
        if UIS:IsKeyDown(Enum.KeyCode.S)     then dir = dir - Camera.CFrame.LookVector  end
        if UIS:IsKeyDown(Enum.KeyCode.A)     then dir = dir - Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D)     then dir = dir + Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0)        end
        if dir.Magnitude > 0 then dir = dir.Unit end
        flyLV.VectorVelocity = dir * S.WalkSpeedVal * 2
    else
        cleanFly()
    end

    -- aimbot
    if not S.Aimbot then locked = false; S.CurrentTarget = nil; return end

    S.CurrentTarget = getClosest()
    locked = S.CurrentTarget ~= nil

    if locked and S.CurrentTarget and S.CurrentTarget.Character then
        local part = S.CurrentTarget.Character:FindFirstChild(S.AimbotPart)
                  or S.CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
        if part then
            local h = S.CurrentTarget.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local vel = Vector3.new()
                pcall(function() vel = part.AssemblyLinearVelocity end)
                local predicted = part.Position + vel * 0.05
                local targetCF  = CFrame.new(Camera.CFrame.Position, predicted)
                Camera.CFrame   = Camera.CFrame:Lerp(targetCF, S.AimbotSmoothing)
            end
        end
    end

    -- trigger
    if S.TriggerBot and S.CurrentTarget and S.CurrentTarget.Character then
        local part = S.CurrentTarget.Character:FindFirstChild(S.TriggerPart)
        if part then
            local sp, on = Camera:WorldToViewportPoint(part.Position)
            if on then
                local cx = Camera.ViewportSize.X/2
                local cy = Camera.ViewportSize.Y/2
                if math.sqrt((sp.X-cx)^2+(sp.Y-cy)^2) < 20 then
                    local c = char and char:FindFirstChildOfClass("Tool")
                    if c then task.delay(S.TriggerReaction, function() pcall(function() c:Activate() end) end) end
                end
            end
        end
    end
end)

